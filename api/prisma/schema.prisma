generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  // One of TODO | IN_PROGRESS | DONE. Validated in the NestJS DTOs via the TaskStatus enum.
  status      String    @default("TODO")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
}
